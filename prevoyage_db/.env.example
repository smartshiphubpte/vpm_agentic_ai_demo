# Pre-voyage DB writer — prefer the same flat JSON as the rest of the stack
# (vpm_config.example.json → vpm_config.json, or VPM_CONFIG_JSON=/path).
# Process env still overrides JSON. Do not commit secrets.
#
# Orion / VoyagePM production layout (discovered from live DB):
#   voyagepm DB  → shipping_db.voyages + shipping_db.master_routes
#   orion DB     → shipping_db.ship (vessel name → id)

# ── Service ─────────────────────────────────────────────────────────
PREVOYAGE_DB_POLL_SECONDS=2
PREVOYAGE_DB_ACTOR=agentic-prevoyage-ingest@system
PREVOYAGE_DB_SCHEMA_VERSION=1
PREVOYAGE_DB_SSLMODE=prefer
# GCP: 15s connect often dies; retry instead of failing the job.
PREVOYAGE_DB_CONNECT_TIMEOUT=45
PREVOYAGE_DB_CONNECT_RETRIES=4
PREVOYAGE_DB_TRANSIENT_ATTEMPTS=4
# Set true to log mapped rows without writing (good for first test)
PREVOYAGE_DB_DRY_RUN=false

VPM_JOBS_DIR=/data/jobs

# Default schemas (both DBs use shipping_db for Orion)
PREVOYAGE_DB_VPM_SCHEMA=shipping_db
PREVOYAGE_DB_CLIENT_SCHEMA=shipping_db

# ── Tenants ─────────────────────────────────────────────────────────
PREVOYAGE_DB_TENANTS=orion

# URL-encode special chars in PASS (? → %3F, + → %2B, = → %3D, @ → %40, etc.)
PREVOYAGE_DB_ORION_VPM_URL=postgresql://USER:PASS@34.93.205.10:5432/voyagepm
PREVOYAGE_DB_ORION_CLIENT_URL=postgresql://USER:PASS@34.93.205.10:5432/orion
PREVOYAGE_DB_ORION_VPM_SCHEMA=shipping_db
PREVOYAGE_DB_ORION_CLIENT_SCHEMA=shipping_db

# ── Client DB vessel lookup (orion.shipping_db.ship — lowercase columns) ──
PREVOYAGE_DB_VESSEL_TABLE=ship
PREVOYAGE_DB_VESSEL_ID_COLUMN=id
PREVOYAGE_DB_VESSEL_NAME_COLUMN=name
PREVOYAGE_DB_VESSEL_MAPPING_COLUMN=mappingname
PREVOYAGE_DB_VESSEL_IMO_COLUMN=imo

# ── VPM DB tables (voyagepm.shipping_db — camelCase quoted columns in SQL) ──
PREVOYAGE_DB_VOYAGES_TABLE=voyages
PREVOYAGE_DB_MASTER_ROUTES_TABLE=master_routes
PREVOYAGE_DB_SUGGESTED_ROUTES_TABLE=suggested_routes
PREVOYAGE_DB_ROUTE_TYPE=captainsRoute

# Client noon table (orion migrated → std_enoonreporttable)
PREVOYAGE_DB_NOON_TABLE=std_enoonreporttable
PREVOYAGE_DB_NOON_REPORT_TYPES=Departure Report,Noon Report,Arrival Report

# ── Ingest side (root .env) ─────────────────────────────────────────
# VPM_TENANT=orion
