# Config for local runs without Docker:
#   Prefer a flat JSON (copy vpm_config.example.json → vpm_config.json), or export
#   the same keys as process env. Python does not load .env files anymore.
#   Lookup order: process env → config store → default / "env variable not set: KEY".
#   Config store: VPM_CONFIG_SOURCE=file|gcp|auto (default auto = local JSON, else GCP
#   if VPM_GCP_SECRET is set). Production Docker: VPM_CONFIG_SOURCE=gcp →
#   projects/605301150765/secrets/DEV-VOYAGEPM-AGENTIC-AGENT (flat JSON payload).
# Docker Compose env_file still injects process env (overrides JSON/secret).
#
# mock | live
VPM_MODE=mock

# Live VoyagePM backend (when VPM_MODE=live)
VPM_BASE_URL=http://localhost:3000/be_voyagepm
VPM_EMAIL=
VPM_PASSWORD=
VPM_COMPANY=

# Live route optimize without voyagepm_be:
#   conventional = A*/Dijkstra corridor graph (local)
#   llm          = LLM call guided by agents/specs/RouteOptimizeLLMAgent.md (set VPM_LLM_PROVIDER)
#   backend      = POST voyagepm_be VO endpoints (needs VPM_BASE_URL up)
VPM_ROUTE_OPT_METHOD=conventional
# conventional only: astar | dijkstra
VPM_ROUTE_OPT_ALGO=astar
# Preferred NM from land for graph nodes (reject is land crossing, not this standoff)
VPM_LAND_CLEARANCE_NM=25

# LLM provider — report narratives + route opt when VPM_ROUTE_OPT_METHOD=llm
#   cursor            = Cursor API key (CURSOR_API_KEY from https://cursor.com/dashboard/api)
#   gemini            = Google Gemini
#   openai            = OpenAI API
#   openai_compatible = any OpenAI-compatible endpoint (Ollama, Azure, …)
VPM_LLM_PROVIDER=cursor
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# VPM_CURSOR_RUNTIME=local

# Google Gemini (when VPM_LLM_PROVIDER=gemini)
# Get a key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# VPM_LLM_MODEL=gemini-2.5-flash
# Default OpenAI-compatible base URL (override only if Google changes it)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# OpenAI / compatible (when VPM_LLM_PROVIDER=openai or openai_compatible)
# VPM_LLM_BASE_URL=http://localhost:11434/v1
# VPM_LLM_API_KEY=
# VPM_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Continuous ops (scripts/run_daemon.py) ──────────────────────────
# Drop pre-voyage Excel (.xlsx) or CSV into incoming/ — picked up → sent/
VPM_INBOX_DIR=

# Drop noon Excel/CSV into incoming/ — picked up → sent/
VPM_NOON_INBOX_DIR=

# Storm snapshots written here every VPM_STORM_INTERVAL_HOURS (independent of voyages)
VPM_STORM_OUT_DIR=

# Generated route / noon reports
VPM_REPORTS_OUT_DIR=

# Report templates for all report types (pre_voyage_route.txt, noon_7day_report.txt, storm_alert.txt, …)
VPM_TEMPLATES_DIR=

# Voyage registry JSON (pre-voyage state keyed by voyage_number)
VPM_REGISTRY_PATH=

# File job bus (ingest/noon drop route-opt work here; routeopt service claims it)
# Docker: use a directory (Compose mounts it at /data/jobs)
VPM_JOBS_DIR=

# Tenant key — tags prevoyage_db jobs and DbNoonSource (must match PREVOYAGE_DB_TENANTS)
VPM_TENANT=

# Timing
VPM_INBOX_POLL_SECONDS=30

# IMAP — email + mailbox password is enough (iPowered: imap.ipower.com, user = full address).
# VPM_MAIL_EMAIL=ops@yourcompany.com
# VPM_MAIL_PASSWORD=
# Optional overrides if autodetect is wrong:
# VPM_MAIL_IMAP_HOST=imap.ipower.com
# VPM_MAIL_IMAP_PORT=993
# VPM_MAIL_IMAP_SSL=true
# VPM_MAIL_IMAP_FOLDER=INBOX
# VPM_MAIL_SUBJECT_CONTAINS=Pre-Dep
# VPM_MAIL_REJECT_TO=ops-review@yourcompany.com
# IMAP check interval (seconds). 900 = 15 minutes. Folder drops still use VPM_INBOX_POLL_SECONDS.
# VPM_MAIL_POLL_SECONDS=900
VPM_STORM_INTERVAL_HOURS=6
VPM_NOON_HORIZON_HOURS=168
VPM_WAYPOINT_INTERVAL_HOURS=6

# Minutes after pre-voyage ingest before weather report is generated (use 1–2 for testing)
VPM_WEATHER_REPORT_DELAY_MINUTES=0

# Noon report source: excel (drop folder) | db (client std_enoonreporttable) | both
VPM_NOON_SOURCE=excel
# Combined noon Excel with all reports (Latitude, Longitude, Voyage_Number columns)
VPM_NOON_EXCEL_PATH=
# Poll interval for noon Excel / DB (seconds) — 120 = every 2 minutes
VPM_NOON_POLL_SECONDS=120
# How many unprocessed noon rows to ingest per poll (1 = one report every 2 min for testing)
VPM_NOON_BATCH_SIZE=1
# Storm within this many NM of voyage route → "likely bad weather" alert
VPM_STORM_ROUTE_THRESHOLD_NM=500

# Tagged daemon flow — see: python3 scripts/run_daemon.py --list-flows
# pre_voyage_weather | pre_voyage_routes | noon_monitoring | storm_monitoring | full
VPM_DAEMON_FLOW=pre_voyage_weather
# Ingest pool: inbox + noon pickup (not blocked by route-opt)
VPM_DAEMON_INGEST_WORKERS=2
# Heavy pool: route optimize, weather, storm
VPM_DAEMON_WORKERS=4

# Weather reports are written under VPM_REPORTS_OUT_DIR/{vessel_imo}/{voyage}/weather_report/
VPM_WEATHER_OUT_DIR=
# Generate passage weather report when noon track is built (true/false)
VPM_WEATHER_REPORT_ON_NOON=true
# Deprecated — passage weather no longer runs on pre-voyage ingest (only after Departure Report)
VPM_WEATHER_REPORT_ON_PREVOYAGE=false
# Weather data: live = Open-Meteo (internet forecast); backend = voyagepm_be /weather/route
VPM_WEATHER_SOURCE=live

# ── Port weather microservice (arrival-triggered, stops after departure) ───────
# Enable/disable this service loop
VPM_PORT_WEATHER=true
# Port-weather reports are written under VPM_REPORTS_OUT_DIR/{vessel_imo}/{voyage}/port_weather/
VPM_PORT_WEATHER_OUT_DIR=
# Send cadence while vessel remains in port after Arrival
VPM_PORT_WEATHER_INTERVAL_HOURS=24
# Registry poll frequency (seconds)
VPM_PORT_WEATHER_POLL_SECONDS=30
# Forecast span written into each report (hours)
VPM_PORT_WEATHER_HORIZON_HOURS=24
# Template file name under VPM_TEMPLATES_DIR
VPM_PORT_WEATHER_TEMPLATE=port_weather_report.txt
# Internal state file (next-due tracker)
VPM_PORT_WEATHER_STATE_PATH=

# ── Report sender microservice (scripts/run_report_sender.py) ───────
# Separate from the daemon — watches a folder and/or polls Postgres DBs.
# Report sender watches nested incoming/ folders under these roots; emailed PDFs → sent/
# Default is VPM_REPORTS_OUT_DIR; add extra roots only for standalone fleet-level outputs.
VPM_REPORT_SENDER_INBOX_DIR=
VPM_REPORT_SENDER_POLL_SECONDS=30
VPM_REPORT_SENDER_FOLDER=true
# Comma-separated Postgres URLs (same schema on each tenant DB)
VPM_REPORT_SENDER_DB=true
VPM_REPORT_SENDER_DB_URLS=
VPM_REPORT_SENDER_DB_POLL_SECONDS=30
# Current recipient source is env; later this can switch to DB fields per voyage/report.
# First-pass review recipient (sent=null, status=null rows → this address)
VPM_REPORT_SENDER_REVIEW_EMAIL=
# Tables: vpm_report(report_link, sent, status) + vpm_voyage_email(voyage_number, email_id)
# VPM_REPORT_SENDER_REPORT_TABLE=vpm_report
# VPM_REPORT_SENDER_VOYAGE_EMAIL_TABLE=vpm_voyage_email
# Voyage lookup for email-body placeholders (vessel name, ports)
# VPM_REPORT_SENDER_VOYAGE_SCHEMA=shipping_db
# VPM_REPORT_SENDER_VOYAGE_TABLE=voyages
# Recipients: env = VPM_REPORT_SENDER_REVIEW_EMAIL / VPM_REPORT_EMAIL
#             db  = vpm_voyage_email (+ registry alert_emails), then env
# VPM_REPORT_EMAIL_SOURCE=env
#
# Email-body drafts (under VPM_TEMPLATES_DIR, fallback templates/). Edit these files
# to change wording. Placeholders: {voyage_number} {vessel_name} {vessel_id}
# {timestamp} {recipients} {voyage_contacts} {source_port} {dest_port} {route_line}
# {port_name} {filename} {report_title} {etd}
# First line may be "Subject: …" and is used as the email subject.
# VPM_REPORT_EMAIL_TEMPLATE_PASSAGE_WEATHER=email_passage_weather.txt
# VPM_REPORT_EMAIL_TEMPLATE_PRE_DEPARTURE=email_pre_departure.txt
# VPM_REPORT_EMAIL_TEMPLATE_STORM_ALERT=email_storm_alert.txt
# VPM_REPORT_EMAIL_TEMPLATE_END_OF_VOYAGE=email_end_of_voyage.txt
# VPM_REPORT_EMAIL_TEMPLATE_PORT_WEATHER=email_port_weather.txt

# SMTP for report sender (shared with legacy VPM_REPORT_EMAIL if unset above)
VPM_REPORT_EMAIL=
VPM_SMTP_HOST=
VPM_SMTP_PORT=587
VPM_SMTP_USER=
VPM_SMTP_PASSWORD=
VPM_SMTP_FROM=

# End-of-voyage report — triggered when an Arrival noon row is processed.
# Runs in a background thread so the daemon keeps polling new voyages.
VPM_EOV_ON_ARRIVAL=true
# Optional override for EOV voyage map. Empty = same OSM.de tiles as VoyagePM GUI
# (https://{s}.tile.openstreetmap.de/{z}/{x}/{y}.png) with route overlay.
# Override: POST JSON {voyage_number, points:[{lat,lon}]} → image/png (or JSON image_base64/url).
VPM_VOYAGE_MAP_URL=
