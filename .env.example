# mock | live
VPM_MODE=mock

# Live VoyagePM backend (when VPM_MODE=live)
VPM_BASE_URL=http://localhost:3000/be_voyagepm
VPM_EMAIL=
VPM_PASSWORD=
VPM_COMPANY=

# Live route optimize without voyagepm_be:
#   conventional = A*/Dijkstra corridor graph (local)
#   llm          = LLM call guided by agents/specs/RouteOptimizeLLMAgent.md (set VPM_LLM_PROVIDER)
#   backend      = POST voyagepm_be VO endpoints (needs VPM_BASE_URL up)
VPM_ROUTE_OPT_METHOD=conventional
# conventional only: astar | dijkstra
VPM_ROUTE_OPT_ALGO=astar
# Preferred NM from land for graph nodes (reject is land crossing, not this standoff)
VPM_LAND_CLEARANCE_NM=25

# LLM provider — route opt when VPM_ROUTE_OPT_METHOD=llm; also free-form goal planning
#   gemini            = Google Gemini (recommended if you have a Gemini API key)
#   openai            = OpenAI API
#   openai_compatible = any OpenAI-compatible endpoint (Ollama, Azure, …)
VPM_LLM_PROVIDER=gemini

# Google Gemini (when VPM_LLM_PROVIDER=gemini)
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model: use GEMINI_MODEL (preferred). VPM_LLM_MODEL also works if it is a Gemini name.
GEMINI_MODEL=gemini-3.6-flash
# VPM_LLM_MODEL=gemini-2.5-flash
# Default OpenAI-compatible base URL (override only if Google changes it)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# OpenAI / compatible (when VPM_LLM_PROVIDER=openai or openai_compatible)
# VPM_LLM_BASE_URL=http://localhost:11434/v1
# VPM_LLM_API_KEY=
# VPM_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Continuous ops (scripts/run_daemon.py) ──────────────────────────
# Drop pre-voyage Excel (.xlsx) or CSV into incoming/ — picked up → sent/
VPM_INBOX_DIR=

# Drop noon Excel/CSV into incoming/ — picked up → sent/
VPM_NOON_INBOX_DIR=

# Storm snapshots written here every VPM_STORM_INTERVAL_HOURS (independent of voyages)
VPM_STORM_OUT_DIR=

# Generated route / noon reports
VPM_REPORTS_OUT_DIR=

# Report templates for all report types (pre_voyage_route.txt, noon_7day_report.txt, storm_alert.txt, …)
VPM_TEMPLATES_DIR=

# Voyage registry JSON (pre-voyage state keyed by voyage_number)
VPM_REGISTRY_PATH=

# File job bus (ingest/noon drop route-opt work here; routeopt service claims it)
# Docker: use a directory (Compose mounts it at /data/jobs)
VPM_JOBS_DIR=

# Tenant key — tags prevoyage_db jobs and DbNoonSource (must match PREVOYAGE_DB_TENANTS)
VPM_TENANT=

# Timing
VPM_INBOX_POLL_SECONDS=30
VPM_STORM_INTERVAL_HOURS=6
VPM_NOON_HORIZON_HOURS=168
VPM_WAYPOINT_INTERVAL_HOURS=6

# Minutes after pre-voyage ingest before weather report is generated (use 1–2 for testing)
VPM_WEATHER_REPORT_DELAY_MINUTES=0

# Noon report source: excel (drop folder) | db (client std_enoonreporttable) | both
VPM_NOON_SOURCE=excel
# Combined noon Excel with all reports (Latitude, Longitude, Voyage_Number columns)
VPM_NOON_EXCEL_PATH=
# Poll interval for noon Excel / DB (seconds) — 120 = every 2 minutes
VPM_NOON_POLL_SECONDS=120
# How many unprocessed noon rows to ingest per poll (1 = one report every 2 min for testing)
VPM_NOON_BATCH_SIZE=1
# Storm within this many NM of voyage route → "likely bad weather" alert
VPM_STORM_ROUTE_THRESHOLD_NM=500

# Tagged daemon flow — see: python3 scripts/run_daemon.py --list-flows
# pre_voyage_weather | pre_voyage_routes | noon_monitoring | storm_monitoring | full
VPM_DAEMON_FLOW=pre_voyage_weather
# Ingest pool: inbox + noon pickup (not blocked by route-opt)
VPM_DAEMON_INGEST_WORKERS=2
# Heavy pool: route optimize, weather, storm
VPM_DAEMON_WORKERS=4

# Weather reports — per-voyage subdirs (defaults to VPM_REPORTS_OUT_DIR if unset)
VPM_WEATHER_OUT_DIR=
# Generate weather report when noon track is built (true/false)
VPM_WEATHER_REPORT_ON_NOON=true
# Generate weather report after pre-voyage ingest (uses VPM_WEATHER_REPORT_DELAY_MINUTES)
VPM_WEATHER_REPORT_ON_PREVOYAGE=true
# Weather data: live = Open-Meteo (internet forecast); backend = voyagepm_be /weather/route
VPM_WEATHER_SOURCE=live

# ── Report sender microservice (scripts/run_report_sender.py) ───────
# Separate from the daemon — watches a folder and/or polls Postgres DBs.
# Report sender watches incoming/ under each path; emailed PDFs → sent/
# Comma-separated roots (reports + weather out dirs)
VPM_REPORT_SENDER_INBOX_DIR=
VPM_REPORT_SENDER_POLL_SECONDS=30
VPM_REPORT_SENDER_FOLDER=true
# Comma-separated Postgres URLs (same schema on each tenant DB)
VPM_REPORT_SENDER_DB=true
VPM_REPORT_SENDER_DB_URLS=
VPM_REPORT_SENDER_DB_POLL_SECONDS=30
# First-pass review recipient (sent=null, status=null rows → this address)
VPM_REPORT_SENDER_REVIEW_EMAIL=
# Tables: vpm_report(report_link, sent, status) + vpm_voyage_email(voyage_number, email_id)
# VPM_REPORT_SENDER_REPORT_TABLE=vpm_report
# VPM_REPORT_SENDER_VOYAGE_EMAIL_TABLE=vpm_voyage_email

# SMTP for report sender (shared with legacy VPM_REPORT_EMAIL if unset above)
VPM_REPORT_EMAIL=
VPM_SMTP_HOST=
VPM_SMTP_PORT=587
VPM_SMTP_USER=
VPM_SMTP_PASSWORD=
VPM_SMTP_FROM=

# End-of-voyage report — triggered when an Arrival noon row is processed.
# Runs in a background thread so the daemon keeps polling new voyages.
VPM_EOV_ON_ARRIVAL=true
# Optional override for EOV voyage map. Empty = same OSM.de tiles as VoyagePM GUI
# (https://{s}.tile.openstreetmap.de/{z}/{x}/{y}.png) with route overlay.
# Override: POST JSON {voyage_number, points:[{lat,lon}]} → image/png (or JSON image_base64/url).
VPM_VOYAGE_MAP_URL=
